# DeepSeek 聊天模型的 API Key（练习 7 问答功能使用）
# 走 OpenAI 兼容协议，baseURL = https://api.deepseek.com，模型 deepseek-chat
DEEPSEEK_API_KEY=

# 硅基流动的 API Key（练习 6 embedding 使用，模型 BAAI/bge-m3，1024 维）
# DeepSeek 官方没有 embedding API，所以 embedding 必须走另一家服务商——
# 这也是本项目存在两套 key 的原因（与 Go 侧 mini-agent/internal/embed 同构）。
SILICONFLOW_API_KEY=

# 设为 1 时，embedding 走"确定性假向量"（同一段文本永远得到同一个向量），
# 不调用真实 API——没有 SILICONFLOW_API_KEY 也能跑通 ingest 全链路。
# 这是可测试性设计：用确定性的 fake 替换外部依赖，让流水线可以离线验证。
EMBEDDING_MOCK=

# 设为 1 时，聊天模型被替换为"确定性假模型"（AI SDK 的 MockLanguageModelV3），
# 返回罐装流式回答——没有 DEEPSEEK_API_KEY 也能跑通练习 7 的问答全链路。
# 注意 mock 只替换 LLM 这一层，检索管线、SSE 流式协议、引用下发都是真的。
CHAT_MOCK=
